  "targets": [
    {
      "name": "KlikMenu",
      "id": "2A8258423010F1A4003FB5CC",
      "product": "Products/KlikMenu.app",
      "product-type": "application",
      "dependencies": [
        "KlikMenuClip",
        "KlikMenuCore",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "copy",
          "name": "Embed App Clips",
          "bundle-base-path": "build-products-directory",
          "relative-path": "$(CONTENTS_FOLDER_PATH)/AppClips",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
