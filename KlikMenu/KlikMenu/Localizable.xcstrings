    "Brak dostępu do kamery. Otwórz Ustawienia, aby włączyć skanowanie kodów QR." : {
      "comment" : "VoiceOver announcement when camera permission is denied.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chybí přístup ke kameře. Otevřete Nastavení a zapněte skenování QR kódů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Kamerazugriff. Öffne die Einstellungen, um das Scannen von QR-Codes zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No camera access. Open Settings to enable QR code scanning."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak dostępu do kamery. Otwórz Ustawienia, aby włączyć skanowanie kodów QR."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chýba prístup ku kamere. Otvorte Nastavenia a zapnite skenovanie QR kódov."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає доступу до камери. Відкрийте Параметри, щоб увімкнути сканування QR-кодів."
          }
        }
      }
    },
    "Brak dostępu do kamery. Włącz go w Ustawieniach, aby skanować kody QR." : {
