  "sourceLanguage" : "pl",
  "strings" : {
    "Brak dostępu do kamery. Włącz go w Ustawieniach, aby skanować kody QR." : {
      "comment" : "Camera permission denied message on the scanner screen.",
      "extractionState" : "manual",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chybí přístup ke kameře. Povolte jej v Nastavení pro skenování QR kódů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Kamerazugriff. Aktiviere ihn in den Einstellungen, um QR-Codes zu scannen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is off. Enable it in Settings to scan QR codes."
          }
        },
