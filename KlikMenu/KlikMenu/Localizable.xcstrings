          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück zum QR-Code-Scanner"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повернутися до сканера QR-кодів"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zpět ke skeneru QR kódů"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Späť ku skeneru QR kódov"
          }
