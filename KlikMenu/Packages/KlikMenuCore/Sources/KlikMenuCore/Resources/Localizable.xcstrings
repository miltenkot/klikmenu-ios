    "Brak połączenia z internetem. Sprawdź sieć i spróbuj ponownie.": {
      "comment": "Network error message.",
      "extractionState": "manual",
      "localizations": {
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak połączenia z internetem. Sprawdź sieć i spróbuj ponownie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection. Check your network and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Internetverbindung. Prüfe das Netzwerk und versuche es erneut."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає з’єднання з інтернетом. Перевірте мережу та спробуйте знову."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádné připojení k internetu. Zkontrolujte síť a zkuste to znovu."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Žiadne pripojenie na internet. Skontrolujte sieť a skúste to znova."
          }
        }
      }
    },
